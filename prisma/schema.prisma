generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String        @default("N0_NAME")
  email                String        @unique(map: "user_email_idx")
  phoneNo              String?       @db.VarChar(20)
  emailVerified        DateTime?     @db.Timestamp(6)
  image                String?
  password             String?
  paymentMethod        String?
  createdTestimonies   Testimony[]   @relation("CreatedBy")
  modifiedTestimonies  Testimony[]   @relation("ModifiedBy")
  createdAt            DateTime      @default(now()) @db.Timestamp(6)
  updatedAt            DateTime      @updatedAt
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  modifiedAddresses    Address[]     @relation("ModifiedByAddress")
  addresses            Address[]     @relation("UserAddresses")
  investments          Investment[]  @relation("UserInvestments")
  inspectorInvestments Investment[]  @relation("InspectorInvestments")
  accounts             Account[]
  sessions             Session[]
  roles                UserRole[]
  modifiedUsers        User[]        @relation("ModifiedByUser")
  modifiedBy           User?         @relation("ModifiedByUser", fields: [modifiedById], references: [id])
  modifiedById         String?       @db.Uuid
  modifiedOn           DateTime?     @db.Timestamp(6)
  modifiedTasks        Task[]        @relation("ModifiedByTask")
  modifiedProductTasks ProductTask[] @relation("ModifiedByProductTask")
  modifiedInvestments  Investment[]  @relation("ModifiedByInvestment")
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Address {
  id            String      @id @default(uuid()) @db.Uuid
  no            String
  line1         String
  phoneNo       String      @db.VarChar(20)
  state         String
  city          String
  code          String?
  gps           String?
  useAsDelivery Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String      @db.Uuid
  addressTypeId String      @db.Uuid
  addressType   AddressType @relation(fields: [addressTypeId], references: [id])
  user          User        @relation("UserAddresses", fields: [userId], references: [id])
  modifiedBy    User?       @relation("ModifiedByAddress", fields: [modifiedById], references: [id])
  modifiedById  String?     @db.Uuid
  modifiedOn    DateTime?   @db.Timestamp(6)
}

model AddressType {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  addresses Address[]
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String
  imageUrl       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  productTasks   ProductTask[]
  investments    Investment[]  @relation("InvestmentToProduct")
  type           ProductType?  @relation(fields: [productTypeId], references: [id])
  productTypeId  String?       @db.Uuid
  class          ProductClass? @relation(fields: [productClassId], references: [id])
  productClassId String?       @db.Uuid
  preTask        PreTask[]
  Task           Task[]
}

model ProductType {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]
}

model ProductClass {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]
}

model PreTask {
  id           String     @id @default(uuid()) @db.Uuid
  investmentId String     @db.Uuid
  title        String // e.g., "Soil Preparation"
  description  String?
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  product      Product?   @relation(fields: [productId], references: [id])
  productId    String?    @db.Uuid
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  investmentId  String       @db.Uuid
  inspectorId   String?      @db.Uuid
  name          String
  description   String
  status        TaskStatus   @default(PENDING)
  imageUrl      String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  productId     String?      @db.Uuid
  productTaskId String?      @db.Uuid
  product       Product?     @relation(fields: [productId], references: [id])
  productTask   ProductTask? @relation(fields: [productTaskId], references: [id])
  audits        TaskAudit[]
  investment    Investment   @relation(fields: [investmentId], references: [id])
  modifiedBy    User?        @relation("ModifiedByTask", fields: [modifiedById], references: [id])
  modifiedById  String?      @db.Uuid
  modifiedOn    DateTime?    @db.Timestamp(6)
}

model ProductTask {
  id           String     @id @default(uuid()) @db.Uuid
  investmentId String     @db.Uuid
  name         String
  description  String
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  productId    String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tasks        Task[]
  modifiedBy   User?      @relation("ModifiedByProductTask", fields: [modifiedById], references: [id])
  modifiedById String?    @db.Uuid
  modifiedOn   DateTime?  @db.Timestamp(6)
  investment   Investment @relation(fields: [investmentId], references: [id])
}

model TaskAudit {
  id        String   @id @default(uuid()) @db.Uuid
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Investment {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  inspectorId    String?          @db.Uuid
  title          String
  productId      String?          @db.Uuid
  amount         Float
  expectedReturn Float            @default(0)
  progress       Int              @default(0)
  investmentType InvestmentType
  status         InvestmentStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation("UserInvestments", fields: [userId], references: [id])
  inspector      User?            @relation("InspectorInvestments", fields: [inspectorId], references: [id])
  products       Product[]        @relation("InvestmentToProduct")
  preTasks       PreTask[]
  tasks          Task[]
  productTasks   ProductTask[]
  modifiedBy     User?            @relation("ModifiedByInvestment", fields: [modifiedById], references: [id])
  modifiedById   String?          @db.Uuid
  modifiedOn     DateTime?        @db.Timestamp(6)
}

model Carousel {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  imageUrl    String
  link        String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  type        String   @default("homepage")
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimony {
  id           String   @id @default(uuid()) @db.Uuid
  investorName String
  comment      String
  rating       Int
  location     String
  isApproved   Boolean  @default(false)
  createdBy    User     @relation(name: "CreatedBy", fields: [createdById], references: [id])
  createdById  String   @db.Uuid
  createdOn    DateTime @default(now())
  modifiedBy   User     @relation(name: "ModifiedBy", fields: [modifiedById], references: [id])
  modifiedById String   @db.Uuid
  modifiedOn   DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum InvestmentType {
  SHORT_TERM //  3-6 months
  MID_TERM //6-12 months
  LONG_TERM // 1+ years
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}
