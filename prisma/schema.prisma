generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // Core Properties
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @default("N0_NAME")
  email         String    @unique(map: "user_email_idx")
  phoneNo       String?   @db.VarChar(20)
  emailVerified DateTime? @db.Timestamp(6)
  image         String?
  password      String?

  // User Token
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Audit
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  createdBy  String?   @db.Uuid
  modifiedBy String?   @db.Uuid
  modifiedAt DateTime? @db.Timestamp(6)

  // Relations
  accounts Account[]
  sessions Session[]
  roles    UserRole[]

  // Payment Method Domains
  paymentDomains PaymentMethodDomain[]

  // Navigation Relations
  modifiedUser  User?  @relation("ModifiedByUser", fields: [modifiedBy], references: [id])
  modifiedUsers User[] @relation("ModifiedByUser")

  investments         Investment[] @relation("UserInvestments")
  createdInvestments  Investment[] @relation("CreatedByInvestment")
  modifiedInvestments Investment[] @relation("ModifiedByInvestment")

  createdProducts  Product[] @relation("CreatedByProduct")
  modifiedProducts Product[] @relation("ModifiedByProduct")

  orders Order[] @relation(name: "UserToOrders")

  createdProductTypes  ProductType[] @relation("CreatedByProductType")
  modifiedProductTypes ProductType[] @relation("ModifiedByProductType")

  createdDurations  Duration[] @relation("CreatedByDuration")
  modifiedDurations Duration[] @relation("ModifiedByDuration")

  createdStates  State[] @relation("CreatedByState")
  modifiedStates State[] @relation("ModifiedByState")

  createdLocations  Location[] @relation("CreatedByLocation")
  modifiedLocations Location[] @relation("ModifiedByLocation")

  createdLands  Land[] @relation("CreatedByLand")
  modifiedLands Land[] @relation("ModifiedByLand")

  createdTestimonies      Testimony[] @relation("CreatedBy")
  modifiedTestimonies     Testimony[] @relation("ModifiedBy")
  addresses               Address[]   @relation("UserAddresses")
  addressesModifiedByUser Address[]   @relation("ModifiedByAddress")
  addressesCreatedByUser  Address[]   @relation("CreatedByUser")

  modifiedTasks Task[] @relation("ModifiedByTask")
  tasks         Task[] @relation("InspectorTasks")

  RolesModifiedByUser   Role[]     @relation("RolesModifiedByUser")
  RolesCreatedByUser    Role[]     @relation("RolesCreatedByUser")
  userRoleCreatedByUser UserRole[] @relation("UserRoleCreatedByUser")

  AccountModifiedByUser Account[] @relation("AccountModifiedByUser")
  accountCreatedByUser  Account[] @relation("AccountCreatedByUser")
  Task                  Task[]
}

model PaymentMethodDomain {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  accountName String
  bankname    String
  cardType    Int    @default(0)
  cardNo      String @db.VarChar(16)
  cvv         String @db.VarChar(3)
  pin         String @db.VarChar(4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  // Audit
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  createdBy  String?   @db.Uuid
  modifiedBy String?   @db.Uuid
  modifiedAt DateTime? @db.Timestamp(6)

  modifiedByUser User? @relation("RolesModifiedByUser", fields: [modifiedBy], references: [id])
  createdByUser  User? @relation("RolesCreatedByUser", fields: [createdBy], references: [id])

  users UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String   @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  assignedByUser User @relation("UserRoleCreatedByUser", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  userId            String  @db.Uuid

  // Audit
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  createdBy  String    @db.Uuid
  modifiedBy String?   @db.Uuid
  modifiedAt DateTime? @db.Timestamp(6)

  modifiedByUser User? @relation("AccountModifiedByUser", fields: [modifiedBy], references: [id])
  createdByUser  User  @relation("AccountCreatedByUser", fields: [createdBy], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  userId       String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id            String  @id @default(uuid()) @db.Uuid
  no            String
  line1         String
  phoneNo       String  @db.VarChar(20)
  state         String
  city          String
  code          String?
  gps           String?
  useAsDelivery Boolean @default(false)
  userId        String  @db.Uuid
  addressTypeId String  @db.Uuid

  createdAt  DateTime @default(now())
  createdBy  String   @db.Uuid
  modifiedAt DateTime @updatedAt
  modifiedBy String?  @db.Uuid

  user        User        @relation("UserAddresses", fields: [userId], references: [id])
  addressType AddressType @relation(fields: [addressTypeId], references: [id])

  modifiedByUser User? @relation("ModifiedByAddress", fields: [modifiedBy], references: [id])
  createdByUser  User  @relation("CreatedByUser", fields: [createdBy], references: [id])
}

model AddressType {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  addresses Address[]
}

model Product {
  id                           String    @id @default(uuid()) @db.Uuid
  name                         String    @unique
  description                  String
  createdAt                    DateTime  @default(now()) @db.Timestamp(6)
  createdBy                    String?   @db.Uuid
  modifiedAt                   DateTime? @db.Timestamp(6)
  modifiedBy                   String?   @db.Uuid
  productTypeId                String    @db.Uuid
  durationId                   String    @db.Uuid
  currentMarketPricePerKg      Float     @default(0)
  farmerMonthlyPayment         Float     @default(10000)
  roi                          Float?     @default(15)
  estimatedHarvestQuantityPerPlot Float   @default(0) // kg per plot per term
  daysToHarvestPerPlot         Int       @default(0) // days per term
  minimumNoOfFarmersPerPlot    Int       @default(1)
  dailyMaintenanceFee          Float     @default(0) // ₦ per day - includes labor costs

  // Remove imageUrl, use ProductImage relation instead
  images         ProductImage[]

  ProductType    ProductType  @relation("ProductToType", fields: [productTypeId], references: [id])
  duration       Duration     @relation("ProductToDuration", fields: [durationId], references: [id])
  investments    Investment[] @relation("InvestmentToProduct")
  marketplaceListings MarketplaceListing[] @relation("ProductToListings")
  createdByUser  User?        @relation("CreatedByProduct", fields: [createdBy], references: [id])
  modifiedByUser User?        @relation("ModifiedByProduct", fields: [modifiedBy], references: [id])
  preTask        PreTask[]
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  productId String   @db.Uuid
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

}

model ProductType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  createdBy   String?   @db.Uuid
  modifiedAt  DateTime? @db.Timestamp(6)
  modifiedBy  String?   @db.Uuid

  prevId                 String?       @db.Uuid
  parent                 ProductType?  @relation("ProductTypeToSub", fields: [prevId], references: [id])
  children               ProductType[] @relation("ProductTypeToSub")
  products               Product[]     @relation("ProductToType")
  productTypeInvestments Investment[]  @relation("ProductTypeToInvestments")
  createdByUser          User?         @relation("CreatedByProductType", fields: [createdBy], references: [id])
  modifiedByUser         User?         @relation("ModifiedByProductType", fields: [modifiedBy], references: [id])
}

model Duration {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  months      Int?       @default(12)
  description String
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  createdBy   String?   @db.Uuid
  modifiedAt  DateTime? @db.Timestamp(6)
  modifiedBy  String?   @db.Uuid

  products       Product[] @relation("ProductToDuration")
  createdByUser  User?     @relation("CreatedByDuration", fields: [createdBy], references: [id])
  modifiedByUser User?     @relation("ModifiedByDuration", fields: [modifiedBy], references: [id])

  @@index([name])
  @@index([createdBy])
  @@index([modifiedBy])
}

model Investment {
  id                        String           @id @default(uuid()) @db.Uuid
  userId                    String           @db.Uuid
  inspectorId               String?          @db.Uuid
  productId                 String           @db.Uuid
  productTypeId             String           @db.Uuid
  landId                    String?          @db.Uuid
  plotSize                  String?
  numberOfPlots             Int              @default(1)
  numberOfTerms             Int              @default(1)
  numberOfFarmers           Int              @default(1)
  amount                    Float
  expectedReturn            Float            @default(0)
  progress                  Int              @default(0)
  status                    InvestmentStatus @default(PENDING)

  // Calculation Results
  totalCost                 Float            @default(0)
  estimatedRevenue          Float            @default(0)
  adjustedRevenue           Float            @default(0)
  netReturn                 Float            @default(0)
  roiPercent                Float            @default(0)
  roiPerDay                 Float            @default(0)
  adjustedYield             Float            @default(0)
  effectiveDaysToHarvest    Int              @default(0)
  estimatedHarvestQuantity  Float            @default(0)

  createdAt                 DateTime         @default(now()) @db.Timestamp(6)
  createdBy                 String?          @db.Uuid
  modifiedAt                DateTime?        @db.Timestamp(6)
  modifiedBy                String?          @db.Uuid

  user           User        @relation("UserInvestments", fields: [userId], references: [id])
  product        Product     @relation("InvestmentToProduct", fields: [productId], references: [id])
  productType    ProductType @relation("ProductTypeToInvestments", fields: [productTypeId], references: [id])
  land           Land?       @relation(fields: [landId], references: [id])
  createdByUser  User?       @relation("CreatedByInvestment", fields: [createdBy], references: [id])
  modifiedByUser User?       @relation("ModifiedByInvestment", fields: [modifiedBy], references: [id])

  marketplaceListings MarketplaceListing[] @relation("InvestmentToListings")

  tasks Task[]
}

model PreTask {
  id                      String    @id @default(uuid()) @db.Uuid
  title                   String
  description             String?
  estimatedCompletionDate DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  productId               String?   @db.Uuid

  product Product? @relation(fields: [productId], references: [id])
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  investmentId String     @db.Uuid
  inspectorId  String?    @db.Uuid
  name         String
  description  String
  status       TaskStatus @default(PENDING)
  imageUrl     String?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  modifiedById String?    @db.Uuid
  modifiedOn   DateTime?  @db.Timestamp(6)

  investment Investment  @relation(fields: [investmentId], references: [id])
  audits     TaskAudit[]
  modifiedBy User?       @relation("ModifiedByTask", fields: [modifiedById], references: [id])
  User       User?       @relation(fields: [userId], references: [id])
  inspector  User?       @relation("InspectorTasks", fields: [inspectorId], references: [id])

  userId String? @db.Uuid
}

model TaskAudit {
  id        String   @id @default(uuid()) @db.Uuid
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String   @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model State {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @unique
  createdAt      DateTime   @default(now()) @db.Timestamp(6)
  createdBy      String?    @db.Uuid
  modifiedAt     DateTime?  @db.Timestamp(6)
  modifiedBy     String?    @db.Uuid
  locations      Location[]
  createdByUser  User?      @relation("CreatedByState", fields: [createdBy], references: [id])
  modifiedByUser User?      @relation("ModifiedByState", fields: [modifiedBy], references: [id])
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  stateId        String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  createdBy      String?   @db.Uuid
  modifiedAt     DateTime? @db.Timestamp(6)
  modifiedBy     String?   @db.Uuid
  state          State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  lands          Land[]
  createdByUser  User?     @relation("CreatedByLocation", fields: [createdBy], references: [id])
  modifiedByUser User?     @relation("ModifiedByLocation", fields: [modifiedBy], references: [id])

  @@unique([name, stateId])
}

model Land {
  id                      String       @id @default(uuid()) @db.Uuid
  locationId              String       @db.Uuid
  name                    String
  gpsCoordinates          String? // e.g., "6.5244,3.3792" for map integration
  dailyPrice              Float        @default(0) // ₦ per day per plot
  imageUrl                String?
  fertilizerCostPerPlot   Float        @default(0) // ₦ per plot per term
  inspectionDailyFee      Float        @default(0) // ₦ per day
  inflationRate           Float        @default(0)
  createdAt               DateTime     @default(now()) @db.Timestamp(6)
  createdBy               String?      @db.Uuid
  modifiedAt              DateTime?    @db.Timestamp(6)
  modifiedBy              String?      @db.Uuid
  location                Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  investments             Investment[]
  createdByUser           User?        @relation("CreatedByLand", fields: [createdBy], references: [id])
  modifiedByUser          User?        @relation("ModifiedByLand", fields: [modifiedBy], references: [id])

  @@unique([name, locationId])
}

model Carousel {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String
  imageUrl    String
  link        String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean          @default(true)
  type        CarouselTypeEnum @default(homepage)
  sortOrder   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Testimony {
  id           String   @id @default(uuid()) @db.Uuid
  investorName String
  comment      String
  rating       Int
  location     String
  isApproved   Boolean  @default(false)
  createdBy    String   @db.Uuid
  modifiedBy   String   @db.Uuid
  createdAt    DateTime @default(now())
  modifiedOn   DateTime @updatedAt

  createdByUser  User @relation(name: "CreatedBy", fields: [createdBy], references: [id])
  modifiedByUser User @relation(name: "ModifiedBy", fields: [modifiedBy], references: [id])
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum CarouselTypeEnum {
  homepage
  category
  testimony
  marketplace
}

model MarketplaceListing {
  id             String    @id @default(uuid()) @db.Uuid
  investmentId   String    @unique @db.Uuid
  productId      String    @db.Uuid
  quantityKg     Float
  pricePerKg     Float
  totalValue     Float
  status         String    @default("PENDING") // PENDING, ACTIVE, SOLD, CANCELLED
  isNegotiable   Boolean   @default(true)
  harvestDate    DateTime
  expiryDate     DateTime?
  description    String?
  marketRating   Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  investment  Investment  @relation("InvestmentToListings", fields: [investmentId], references: [id], onDelete: Cascade)
  product     Product     @relation("ProductToListings", fields: [productId], references: [id])
  orderItems  OrderItem[] @relation("ListingToOrderItems")

  @@index([investmentId])
  @@index([productId])
  @@index([status])
}

model Order {
  id               String   @id @default(uuid()) @db.Uuid
  buyerId          String?  @db.Uuid // Optional - allows anonymous buyers
  totalAmount      Float
  status           String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus    String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  deliveryAddress  String
  customerName     String?  // For anonymous buyers
  customerEmail    String?  // For anonymous buyers
  customerPhone    String?  // For anonymous buyers
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyer      User?       @relation("UserToOrders", fields: [buyerId], references: [id])
  orderItems OrderItem[] @relation("OrderToOrderItems")

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  listingId  String   @db.Uuid
  quantityKg Float
  pricePerKg Float
  subtotal   Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order   Order              @relation("OrderToOrderItems", fields: [orderId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation("ListingToOrderItems", fields: [listingId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([listingId])
}

